{
  "name": "islamic-learning-duolingo-style",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend": "python -m uvicorn backend.app.main:app --reload --port 8000",
    "backend:legacy": "node backend/server.js",
    "backend:migrate": "python -m alembic -c backend/alembic.ini upgrade head",
    "backend:seed": "python -m backend.scripts.seed_content",
    "backend:bootstrap": "python -m backend.scripts.bootstrap",
    "typecheck": "tsc --noEmit",
    "import:notes": "node scripts/obsidian-import/import-obsidian-notes.mjs",
    "test:notes": "node --test scripts/obsidian-import/lib.test.mjs && python -m pytest backend/tests/test_imported_notes.py -q",
    "test": "jest",
    "test:backend": "python -m pytest backend/tests",
    "sounds:generate": "node scripts/generate-game-sounds.mts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-bhaijaan-2": "^0.4.2",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~55.0.0",
    "expo-apple-authentication": "~55.0.17",
    "expo-audio": "~55.0.13",
    "expo-auth-session": "~55.0.13",
    "expo-dev-client": "~55.0.25",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-notifications": "~55.0.18",
    "expo-speech": "~55.0.13",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-google-mobile-ads": "17.0.0",
    "react-native-purchases": "^10.14.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "patch-package": "^8.0.0",
    "test-renderer": "^1.3.1",
    "typescript": "^5.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
