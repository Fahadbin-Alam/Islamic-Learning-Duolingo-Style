# Leave empty to ship an offline-only build; set it once the API is deployed (see docs/release.md).
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_MONETIZATION_MODE=disabled
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=ADD_REVENUECAT_APPLE_PUBLIC_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=ADD_REVENUECAT_GOOGLE_PUBLIC_KEY
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
EXPO_PUBLIC_REVENUECAT_NO_ADS_ENTITLEMENT_ID=no_ads
EXPO_PUBLIC_MONTHLY_PRODUCT_ID=membership_monthly
EXPO_PUBLIC_YEARLY_PRODUCT_ID=membership_yearly
EXPO_PUBLIC_NO_ADS_MONTHLY_PRODUCT_ID=no_ads_monthly
EXPO_PUBLIC_NO_ADS_YEARLY_PRODUCT_ID=no_ads_yearly
EXPO_PUBLIC_HEART_PACK_PRODUCT_ID=heart_pack_small
EXPO_PUBLIC_GEM_PACK_PRODUCT_ID=gem_pack_medium
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ADD_ANDROID_BANNER_UNIT_ID
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=ADD_ANDROID_REWARDED_UNIT_ID
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=ADD_ANDROID_INTERSTITIAL_UNIT_ID
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ADD_IOS_BANNER_UNIT_ID
EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=ADD_IOS_REWARDED_UNIT_ID
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_UNIT_ID=ADD_IOS_INTERSTITIAL_UNIT_ID
# Defaults to the GitHub Pages copies under site/ when left empty.
EXPO_PUBLIC_TERMS_URL=https://fahadbin-alam.github.io/Islamic-Learning-Duolingo-Style/terms.html
EXPO_PUBLIC_PRIVACY_URL=https://fahadbin-alam.github.io/Islamic-Learning-Duolingo-Style/privacy.html
# Read at build time by app.config.js (not shipped in the JS bundle).
ADMOB_ANDROID_APP_ID=ADD_ANDROID_ADMOB_APP_ID
ADMOB_IOS_APP_ID=ADD_IOS_ADMOB_APP_ID
# Google sign-in (src/config/auth.ts). The backend checks tokens against the same web client id
# (SIRA_GOOGLE_CLIENT_IDS_RAW). Android needs no id here, only an Android client in Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=ADD_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=ADD_GOOGLE_IOS_CLIENT_ID
# Anonymous usage stats and crash reports (src/services/analytics.ts, docs/analytics.md). PostHog project API key
# (starts with phc_; it is a public key). Unset: nothing is sent. Host only for the EU cloud: https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

SIRA_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sira_path
SIRA_ENVIRONMENT=production
# Only browsers need CORS; the phone apps ignore it.
SIRA_CORS_ORIGINS_RAW=
SIRA_SESSION_TTL_HOURS=720
SIRA_REVENUECAT_WEBHOOK_AUTH=ADD_LONG_RANDOM_SECRET
# Same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID. Apple tokens are checked against the bundle id by default.
SIRA_GOOGLE_CLIENT_IDS_RAW=ADD_GOOGLE_WEB_CLIENT_ID
