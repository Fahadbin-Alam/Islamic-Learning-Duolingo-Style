<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/daily_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/daily_widget_ayah_label"
        android:text="@string/daily_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/daily_widget_ayah_chip"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#178A56"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_widget_ayah_arabic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textDirection="rtl"
        android:ellipsize="end"
        android:textColor="#1F2D27"
        android:textSize="20sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="24sp" />

    <TextView
        android:id="@+id/daily_widget_ayah_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#4A5A53"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/daily_widget_ayah_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#178A56"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/daily_widget_hadith"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/daily_widget_hadith_card"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/daily_widget_hadith_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1683D1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/daily_widget_hadith_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#1F2D27"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/daily_widget_hadith_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#6A7A73"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
